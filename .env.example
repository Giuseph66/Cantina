# ─── API ───────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/cantina.db"
PORT=3000
NODE_ENV=development
APP_PUBLIC_URL="http://localhost:3000"

# JWT
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING"
JWT_EXPIRES_IN="8h"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Google Auth
GOOGLE_WEB_CLIENT_ID=""

# Pagamentos online
PAYMENTS_NEW_CHARGES_ENABLED=true
SALES_ENABLED=false
ASAAS_ENV=sandbox
ASAAS_ACCOUNT_REF=""
ASAAS_API_KEY_SANDBOX=""
ASAAS_API_KEY_PRODUCTION=""
ASAAS_WEBHOOK_TOKEN_SANDBOX=""
ASAAS_WEBHOOK_TOKEN_PRODUCTION=""
ASAAS_CALLBACK_SUCCESS_URL=""

# Webhooks
